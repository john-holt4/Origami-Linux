[Desktop Entry]
Type=Application
Version=1.0
Name=RakuOS Migration Assistant
Comment=Guide Origami Linux users through migrating to RakuOS
Exec=/usr/share/origami/migrate-to-rakuos.sh
TryExec=/usr/share/origami/migrate-to-rakuos.sh
Icon=/usr/share/pixmaps/origami-logo.png
Terminal=false
StartupNotify=true
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Applications
X-GNOME-Autostart-Delay=12
